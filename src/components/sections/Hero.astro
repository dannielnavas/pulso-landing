            </div>

            <!-- Integrated Audio Visualizer Mini Spectrum inside the Liquid Glass Dock -->
            <div class="mt-2 pt-2 border-t border-white/[0.06] flex items-center justify-between text-[10px] font-mono text-zinc-400">
              <span class="flex items-center gap-1.5 text-zinc-300">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span>SPONSORBLOCK NATIVO ACTIVO • SALTO AUTOMÁTICO</span>
