---
---

<section id="showcase" class="relative pt-28 pb-16 sm:pt-36 sm:pb-24 lg:pt-40 lg:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial Headline & Value Proposition -->
    <div class="text-center max-w-4xl mx-auto">
      <p class="text-xs sm:text-sm font-semibold tracking-widest uppercase text-[#F9EBD7] mb-4 select-none">
        Reproductor Nativo de Código Abierto • v0.1.0
      </p>

      <!-- Single SEO H1 with pure white high-contrast solid typography -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.08] text-balance">
        El reproductor de YouTube Music que tu escritorio se merecía.
      </h1>

      <p class="mt-6 text-base sm:text-xl text-zinc-300 max-w-2xl mx-auto font-normal leading-relaxed text-balance">
        Una experiencia de escritorio nativa con estética <strong class="text-white font-semibold">Liquid Glass</strong>, ultraligera y sin interrupciones. Conéctate con tu cuenta, despídete de los patrocinios con <strong class="text-white font-semibold">SponsorBlock integrado</strong> y disfruta tu música en un dock flotante de cristal esmerilado.
      </p>

      <!-- High-Impact Call to Action Area -->
      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
        <!-- Dynamic Primary Download Button -->
        <a
          id="hero-download-cta"
          href="#downloads"
          class="group relative inline-flex items-center justify-center gap-3 w-full sm:w-auto px-8 py-4 text-base font-bold text-[#02180c] bg-[#F9EBD7] hover:bg-white active:bg-[#dfcfb9] rounded-xl shadow-xl shadow-[#F9EBD7]/20 transition-all duration-200 hover:scale-[1.02] active:scale-[0.99] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F9EBD7] border border-[#F9EBD7]/40"
          aria-label="Descargar Pulso para tu sistema operativo"
        >
          <!-- Dynamic OS Icon Container -->
          <span id="hero-os-icon" class="text-[#02180c]">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.66-.99 1.73-.85 2.76 1.01.08 1.96-.51 2.58-1.26z"/>
            </svg>
          </span>
          <span id="hero-download-text">Descargar para macOS</span>
          <span id="hero-download-detail" class="hidden sm:inline-block text-xs font-semibold text-[#F9EBD7] bg-[#046A38] border border-[#F9EBD7]/30 px-2 py-0.5 rounded">.dmg</span>
        </a>

        <!-- Secondary GitHub Action -->
        <a
          href="https://github.com/dannielnavas/ytmdannieldev"
          target="_blank"
          rel="noopener noreferrer"
          class="liquid-pill inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-6 py-4 text-base font-semibold text-zinc-200 hover:text-[#F9EBD7] rounded-xl transition-all duration-200 active:scale-[0.99] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F9EBD7]"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>Ver en GitHub</span>
        </a>
      </div>

      <!-- Quick platform picker indicator -->
      <div class="mt-4 flex items-center justify-center gap-3 text-xs text-zinc-400">
        <span>Disponible para macOS, Windows y Linux</span>
        <span class="text-zinc-600">•</span>
        <a href="#downloads" class="text-zinc-300 hover:text-[#F9EBD7] underline decoration-zinc-700 underline-offset-4 transition-colors">
          Ver todas las opciones e instrucciones Gatekeeper
        </a>
      </div>
    </div>

    <!-- Authentic Pulso Desktop Application Showcase with Floating Liquid Glass Player -->
    <div class="mt-14 sm:mt-20 relative max-w-6xl mx-auto">
      
      <!-- Dynamic Ambient Backlight -->
      <div id="showcase-ambient-backlight" class="absolute -inset-4 sm:-inset-8 bg-[#046A38]/35 blur-3xl rounded-3xl opacity-75 transition-all duration-700 -z-10 pointer-events-none"></div>

      <!-- Native Desktop Window Frame -->
      <div class="rounded-3xl border border-[#F9EBD7]/20 bg-[#040e08]/95 shadow-[0_32px_80px_rgba(0,0,0,0.85)] backdrop-blur-3xl overflow-hidden transition-all duration-300 relative">
        
        <!-- App Window Header Bar (Traffic lights + Search Bar + Profile) -->
        <div class="h-14 px-4 sm:px-6 bg-[#020a05]/80 border-b border-white/[0.08] flex items-center justify-between gap-4 select-none">
          <!-- Window traffic lights -->
          <div class="flex items-center gap-2 shrink-0">
            <span class="w-3 h-3 rounded-full bg-rose-500/90 inline-block shadow-sm"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/90 inline-block shadow-sm"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/90 inline-block shadow-sm"></span>
          </div>

          <!-- App Search Bar (From user's real app) -->
          <div class="hidden sm:flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.05] border border-white/10 text-xs text-zinc-400 max-w-md w-full">
            <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="truncate">Buscar canciones, álbumes, artistas...</span>
          </div>

          <!-- Header Right: Premium Badge & User Profile (From user's app) -->
          <div class="flex items-center gap-3 shrink-0">
            <!-- Premium Pill -->
            <div class="hidden md:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-[11px] font-semibold">
              <span>👑</span>
              <span>Premium</span>
            </div>

            <!-- User avatar -->
            <div class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/[0.06] border border-white/10 text-xs">
              <div class="w-5 h-5 rounded-full bg-gradient-to-tr from-[#046A38] to-[#F9EBD7] flex items-center justify-center text-[10px] text-[#02180c] font-bold">
                D
              </div>
              <span class="text-zinc-200 font-medium hidden sm:inline">DannielDev</span>
            </div>

            <!-- Dynamic Theme / Color Switcher for interactive demo -->
            <div class="flex items-center gap-1 pl-2 border-l border-white/10">
              <button class="palette-switch-btn w-4 h-4 rounded-full bg-[#F9EBD7] ring-2 ring-white/40 hover:scale-110 transition-transform" data-theme="cream" data-color="#F9EBD7" data-track="Acústica Nocturna" data-artist="Verdant" aria-label="Paleta Marfil Principal"></button>
              <button class="palette-switch-btn w-4 h-4 rounded-full bg-[#046A38] border border-[#F9EBD7]/40 hover:scale-110 transition-transform" data-theme="pine" data-color="#046A38" data-track="Bosque Profundo" data-artist="Kroma" aria-label="Paleta Pino Secundario"></button>
              <button class="palette-switch-btn w-4 h-4 rounded-full bg-[#E34222] hover:scale-110 transition-transform" data-theme="vermilion" data-color="#E34222" data-track="Pulso Carmesí" data-artist="Dominic" aria-label="Paleta Carmesí Tercero"></button>
            </div>
          </div>
        </div>

        <!-- App Body Dashboard (Faithfully replicating the uploaded screenshot) -->
        <div class="p-5 sm:p-8 space-y-6 pb-40 relative select-none">
          
          <!-- Dashboard Title & Filters Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2.5">
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Dashboard</h2>
                <span class="px-2.5 py-0.5 rounded-full bg-[#046A38]/60 border border-[#F9EBD7]/40 text-[#F9EBD7] text-[10px] font-bold tracking-wider uppercase">
                  ✦ Personal + YouTube
                </span>
              </div>
              <p class="text-xs sm:text-sm text-zinc-400 mt-1 font-normal">
                Tus analíticas con Last.fm, canciones guardadas y descubrimiento musical en un solo lugar.
              </p>
            </div>

            <!-- View filter pills -->
            <div class="flex items-center gap-1.5 text-xs">
              <button class="px-3.5 py-1.5 rounded-xl bg-[#046A38] text-[#F9EBD7] border border-[#F9EBD7]/40 font-semibold shadow-md shadow-[#046A38]/50 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                <span>Todo</span>
              </button>
              <button class="px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-zinc-300 border border-white/10 flex items-center gap-1.5 transition-colors">
                <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                <span>Tu Música</span>
              </button>
              <button class="px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-zinc-300 border border-white/10 flex items-center gap-1.5 transition-colors">
                <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
                <span>Explorar</span>
              </button>
            </div>
          </div>

          <!-- 4 Stat Metric Cards (Subtle glassmorphic surface with colored glow icons) -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            
            <!-- Card 1: Me Gusta -->
            <div class="liquid-card rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-xs text-zinc-400 font-medium">Tus Me Gusta</span>
                <div class="w-7 h-7 rounded-lg bg-[#E34222]/15 border border-[#E34222]/30 flex items-center justify-center text-[#E34222]">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </div>
              </div>
              <div class="mt-3">
                <div class="text-2xl sm:text-3xl font-extrabold text-white">9</div>
                <div class="text-[11px] text-zinc-400 mt-0.5">Canciones guardadas</div>
              </div>
            </div>

            <!-- Card 2: Tiempo de Música -->
            <div class="liquid-card rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-xs text-zinc-400 font-medium">Tiempo de Música</span>
                <div class="w-7 h-7 rounded-lg bg-[#046A38]/50 border border-[#F9EBD7]/20 flex items-center justify-center text-[#F9EBD7]">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
              </div>
              <div class="mt-3">
                <div class="text-2xl sm:text-3xl font-extrabold text-white">0.1 <span class="text-sm font-normal text-zinc-400">horas</span></div>
                <div class="text-[11px] text-zinc-400 mt-0.5">4 minutos acumulados</div>
              </div>
            </div>

            <!-- Card 3: Artistas Distintos -->
            <div class="liquid-card rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-xs text-zinc-400 font-medium">Artistas Distintos</span>
                <div class="w-7 h-7 rounded-lg bg-[#046A38]/40 border border-[#046A38]/60 flex items-center justify-center text-emerald-300">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
              </div>
              <div class="mt-3">
                <div class="text-2xl sm:text-3xl font-extrabold text-white">8</div>
                <div class="text-[11px] text-zinc-400 mt-0.5">En tu colección personal</div>
              </div>
            </div>

            <!-- Card 4: Artista Favorito -->
            <div class="liquid-card rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
              <div class="flex items-center justify-between">
                <span class="text-xs text-zinc-400 font-medium">Artista Favorito</span>
                <div class="w-7 h-7 rounded-lg bg-[#F9EBD7]/15 border border-[#F9EBD7]/30 flex items-center justify-center text-[#F9EBD7]">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>
                </div>
              </div>
              <div class="mt-3">
                <div class="text-xl sm:text-2xl font-extrabold text-white truncate">José Madero</div>
                <div class="text-[11px] text-zinc-400 mt-0.5">Top reproducciones</div>
              </div>
            </div>

          </div>

          <!-- Shelf Section: Tus Artistas Principales -->
          <div class="space-y-3 pt-2">
            <div class="flex items-center gap-2">
              <h3 class="text-lg font-bold text-white">Tus Artistas Principales</h3>
              <span class="px-2 py-0.5 rounded bg-[#046A38] border border-[#F9EBD7]/20 text-[#F9EBD7] text-[10px] font-mono font-bold">LAST.FM</span>
            </div>

            <!-- Artist Cards Row -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
              <div class="liquid-card rounded-2xl p-3 space-y-2">
                <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-[#046A38] to-zinc-800 flex items-center justify-center text-white/40">
                  <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="text-sm font-bold text-white truncate">José Madero</div>
                <div class="text-[11px] text-zinc-400">Top 1 • Pop/Rock</div>
              </div>

              <div class="liquid-card rounded-2xl p-3 space-y-2">
                <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-[#046A38] to-zinc-800 flex items-center justify-center text-white/40">
                  <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="text-sm font-bold text-white truncate">Moving ON</div>
                <div class="text-[11px] text-zinc-400">Top 2 • Indie</div>
              </div>

              <div class="liquid-card rounded-2xl p-3 space-y-2">
                <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-[#046A38] to-zinc-800 flex items-center justify-center text-white/40">
                  <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="text-sm font-bold text-white truncate">Dominic</div>
                <div class="text-[11px] text-zinc-400">Top 3 • Post-Punk</div>
              </div>

              <div class="liquid-card rounded-2xl p-3 space-y-2 hidden sm:block">
                <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-[#046A38] to-zinc-800 flex items-center justify-center text-white/40">
                  <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <div class="text-sm font-bold text-white truncate">Kavinsky</div>
                <div class="text-[11px] text-zinc-400">Top 4 • Synthwave</div>
              </div>
            </div>
          </div>

        </div>

        <!-- ======================================================== -->
        <!-- THE ICONIC FLOATING LIQUID GLASS PLAYER DOCK (FROM APP)  -->
        <!-- ======================================================== -->
        <div class="absolute bottom-3 sm:bottom-5 left-3 sm:left-6 right-3 sm:right-6 z-30">
          
          <!-- Liquid Glass Dock Capsule -->
          <div id="liquid-player-dock" class="liquid-glass-dock rounded-2xl sm:rounded-3xl p-3 sm:p-4 transition-all duration-500">
            
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
              
              <!-- Left: Album Art & Track Info -->
              <div class="flex items-center gap-3 shrink-0">
                <div class="relative w-12 h-12 sm:w-14 sm:h-14 rounded-xl overflow-hidden shadow-lg border border-[#F9EBD7]/20 bg-zinc-900 shrink-0">
                  <div id="dock-cover-art" class="w-full h-full bg-gradient-to-tr from-[#046A38] via-zinc-900 to-[#02180c] flex items-center justify-center text-[#F9EBD7] font-bold text-xs p-1 text-center">
                    Adiós BA
                  </div>
                </div>

                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h4 id="dock-track-title" class="text-sm sm:text-base font-bold text-white truncate">Adiós Buenos Aires</h4>
                    <!-- Tercero Red/Flame Heart Icon -->
                    <button class="text-[#E34222] hover:scale-110 transition-transform shrink-0" aria-label="Favorito">
                      <svg class="w-4 h-4 fill-current drop-shadow-[0_0_8px_rgba(227,66,34,0.6)]" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    </button>
                  </div>
                  <p id="dock-track-artist" class="text-xs text-zinc-400 truncate">Dominic • 1/9</p>
                </div>
              </div>

              <!-- Center: Playback Controls & Timeline Scrubber -->
              <div class="flex-1 max-w-xl mx-auto w-full space-y-2">
                
                <!-- Controls Row -->
                <div class="flex items-center justify-center gap-5 sm:gap-6">
                  <!-- Shuffle -->
                  <button class="text-zinc-400 hover:text-white transition-colors" aria-label="Aleatorio">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
                  </button>

                  <!-- Prev -->
                  <button class="text-zinc-400 hover:text-white transition-colors" aria-label="Anterior">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><polygon points="19 20 9 12 19 4 19 20"></polygon><line x1="5" y1="19" x2="5" y2="5" stroke="currentColor" stroke-width="2"></line></svg>
                  </button>

                  <!-- Master Play / Pause Button (Tactile White Pill Circle) -->
                  <button
                    id="dock-master-play-btn"
                    class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white text-zinc-950 flex items-center justify-center shadow-[0_4px_24px_rgba(249,235,215,0.35)] hover:scale-105 active:scale-95 transition-all cursor-pointer"
                    aria-label="Reproducir o pausar"
                  >
                    <svg id="dock-play-icon" class="w-5 h-5 ml-0.5 fill-current" viewBox="0 0 24 24">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </button>

                  <!-- Next -->
