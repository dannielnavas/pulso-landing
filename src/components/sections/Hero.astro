<!-- Client Script: Dynamic OS Detection & Interactive Liquid Dock Playback -->
<script>
  function detectClientOS() {
    const userAgent = window.navigator.userAgent.toLowerCase();
    const cta = document.getElementById('hero-download-cta');
    const text = document.getElementById('hero-download-text');
    const detail = document.getElementById('hero-download-detail');
    const iconContainer = document.getElementById('hero-os-icon');

    if (!cta || !text || !detail || !iconContainer) return;

    if (userAgent.includes('mac')) {
      text.textContent = 'Descargar para macOS';
      detail.textContent = '.dmg • Apple Silicon / Intel';
      cta.setAttribute('href', '#downloads-mac');
      iconContainer.innerHTML = `
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.66-.99 1.73-.85 2.76 1.01.08 1.96-.51 2.58-1.26z"/>
        </svg>
      `;
    } else if (userAgent.includes('win')) {
      text.textContent = 'Descargar para Windows';
      detail.textContent = '.exe • Win 10/11';
      cta.setAttribute('href', '#downloads-windows');
      iconContainer.innerHTML = `
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
        </svg>
      `;
    } else if (userAgent.includes('linux')) {
      text.textContent = 'Descargar para Linux';
      detail.textContent = '.AppImage • Universal';
      cta.setAttribute('href', '#downloads-linux');
      iconContainer.innerHTML = `
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12.002 0c-3.13 0-5.672 2.628-5.672 5.867 0 1.222.378 2.355 1.018 3.292C4.167 10.74 2 13.914 2 17.653c0 3.504 2.837 6.347 6.341 6.347 1.838 0 3.493-.78 4.66-2.032a7.35 7.35 0 0 0 3.66 2.032c3.504 0 6.34-2.843 6.34-6.347 0-3.74-2.167-6.913-5.348-8.494.64-.937 1.018-2.07 1.018-3.292C18.671 2.628 16.13 0 12.002 0zm0 2.2c1.92 0 3.473 1.637 3.473 3.667 0 2.03-1.553 3.666-3.473 3.666-1.92 0-3.472-1.636-3.472-3.666 0-2.03 1.552-3.667 3.472-3.667z"/>
        </svg>
      `;
    }
  }

  // Mini canvas visualizer inside dock
  function initDockVisualizer() {
    const canvas = document.getElementById('dock-mini-visualizer') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let isPlaying = true;
    const barCount = 24;
    const values = new Array(barCount).fill(0).map(() => Math.random() * 0.5 + 0.1);
    const targets = new Array(barCount).fill(0).map(() => Math.random());
    let currentAccent = '#ffffff';

    function draw() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      if (canvas.width !== rect.width * dpr || canvas.height !== rect.height * dpr) {
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx?.scale(dpr, dpr);
      }

      ctx.clearRect(0, 0, rect.width, rect.height);
      const barWidth = (rect.width - (barCount - 1) * 2) / barCount;

      for (let i = 0; i < barCount; i++) {
        if (isPlaying) {
          values[i] += (targets[i] - values[i]) * 0.18;
          if (Math.abs(targets[i] - values[i]) < 0.05) {
            targets[i] = Math.random() * 0.8 + 0.2;
          }
        } else {
          values[i] += (0.05 - values[i]) * 0.1;
        }

        const barHeight = Math.max(2, values[i] * rect.height);
        const x = i * (barWidth + 2);
        const y = rect.height - barHeight;

        ctx.fillStyle = currentAccent;
        ctx.globalAlpha = 0.8;
        ctx.beginPath();
        ctx.roundRect(x, y, barWidth, barHeight, [1, 1, 0, 0]);
        ctx.fill();
      }

      requestAnimationFrame(draw);
    }

    draw();

    // Toggle Play Button
    const playBtn = document.getElementById('dock-master-play-btn');
    const playIcon = document.getElementById('dock-play-icon');

    playBtn?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (playIcon) {
        if (isPlaying) {
          playIcon.innerHTML = `<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>`;
        } else {
          playIcon.innerHTML = `<polygon points="5 3 19 12 5 21 5 3"></polygon>`;
        }
      }
    });

    // Palette Switcher
    const buttons = document.querySelectorAll('.palette-switch-btn');
    const backlight = document.getElementById('showcase-ambient-backlight');
    const ambientStagePrimary = document.getElementById('ambient-glow-primary');
    const dockTrack = document.getElementById('dock-track-title');
    const dockArtist = document.getElementById('dock-track-artist');
    const dockCover = document.getElementById('dock-cover-art');
    const dockProgress = document.getElementById('dock-progress-fill');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('ring-2', 'ring-white/40'));
        btn.classList.add('ring-2', 'ring-white/40');

        const color = btn.getAttribute('data-color') || '#F9EBD7';
        const track = btn.getAttribute('data-track') || 'Acústica Nocturna';
        const artist = btn.getAttribute('data-artist') || 'Verdant';

        if (dockTrack) dockTrack.textContent = track;
        if (dockArtist) dockArtist.textContent = `${artist} • 1/9`;
        if (dockCover) dockCover.textContent = track.substring(0, 8);
        if (backlight) backlight.style.backgroundColor = `${color}40`;
        if (ambientStagePrimary) ambientStagePrimary.style.backgroundColor = `${color}25`;
        if (dockProgress) dockProgress.style.backgroundColor = color;
        currentAccent = color;
      });
    });
  }

  detectClientOS();
  initDockVisualizer();
</script>
