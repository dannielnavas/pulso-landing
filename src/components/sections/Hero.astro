                <!-- Volume Slider -->
                <div class="hidden md:flex items-center gap-2">
                  <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                  <div class="w-16 h-1.5 bg-white/20 rounded-full overflow-hidden">
