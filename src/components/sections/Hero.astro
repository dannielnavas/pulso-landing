                  </button>
                </div>

                <!-- Timeline Bar with SponsorBlock Skip Indicator -->
                <div class="flex items-center gap-3 text-[11px] font-mono text-zinc-400 select-none">
                  <span>0:27</span>
                  <div class="relative flex-1 h-1.5 sm:h-2 bg-white/10 rounded-full overflow-hidden cursor-pointer" title="Línea de tiempo con salto de SponsorBlock">
                    <!-- Progress fill -->
                    <div id="dock-progress-fill" class="absolute left-0 top-0 bottom-0 w-[35%] bg-[#E34222] rounded-full transition-all duration-300 shadow-[0_0_8px_rgba(227,66,34,0.5)]"></div>
                    <!-- SponsorBlock auto-skipped segment -->
                    <div class="absolute left-[18%] top-0 bottom-0 w-[12%] bg-emerald-400/90 rounded-sm" title="Segmento de patrocinio omitido automáticamente"></div>
