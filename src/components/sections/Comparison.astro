---
---

<section id="comparativa" class="py-24 sm:py-32 border-t border-white/[0.06] relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Identifier -->
    <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-zinc-500 mb-6">
      <span class="text-[#E34222] font-bold">04</span>
      <span>//</span>
      <span>BENCHMARK Y COMPARATIVA</span>
    </div>

    <!-- Editorial Headline -->
    <div class="mb-14 sm:mb-16">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15] text-balance">
        Pulso frente a una pestaña tradicional del navegador.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-300 font-normal leading-relaxed text-balance">
        Abrir YouTube Music en Chrome o Edge no solo consume cientos de megabytes en procesos secundarios; te priva de funciones de audio dedicadas y controles nativos.
      </p>
    </div>

    <!-- Comparison Table / Board (Clean typographic rows, minimal hairline dividers) -->
    <div class="border-t border-white/10 divide-y divide-white/[0.06]">
      
      <!-- Table Header -->
      <div class="py-4 grid grid-cols-12 text-xs font-mono uppercase tracking-wider text-zinc-400">
        <div class="col-span-6 sm:col-span-5 text-zinc-400">Funcionalidad</div>
        <div class="col-span-3 sm:col-span-3 text-zinc-400 text-center">Pestaña Web</div>
        <div class="col-span-3 sm:col-span-4 text-[#F9EBD7] font-bold text-center sm:text-right sm:pr-4">Pulso Desktop</div>
      </div>

      <!-- Row 1: SponsorBlock -->
      <div class="py-5 grid grid-cols-12 items-center text-sm">
        <div class="col-span-6 sm:col-span-5 pr-4">
          <div class="font-bold text-white">SponsorBlock Automático</div>
          <div class="text-xs text-zinc-400 mt-0.5">Omisión milimétrica de intros, patrocinios y silencios</div>
        </div>
        <div class="col-span-3 sm:col-span-3 text-center text-zinc-400 text-xs">
          <span class="text-red-400 font-medium">✕ Requiere extensiones</span>
        </div>
        <div class="col-span-3 sm:col-span-4 text-center sm:text-right sm:pr-4">
          <span class="text-emerald-400 font-semibold text-xs sm:text-sm">✓ Nativo y configurable</span>
        </div>
      </div>

      <!-- Row 2: Consumo de memoria -->
      <div class="py-5 grid grid-cols-12 items-center text-sm">
        <div class="col-span-6 sm:col-span-5 pr-4">
          <div class="font-bold text-white">Huella de Memoria RAM</div>
          <div class="text-xs text-zinc-400 mt-0.5">Impacto en los recursos del sistema en segundo plano</div>
        </div>
        <div class="col-span-3 sm:col-span-3 text-center text-zinc-400 text-xs font-mono">
          ~650 - 900 MB
        </div>
        <div class="col-span-3 sm:col-span-4 text-center sm:text-right sm:pr-4">
          <span class="text-white font-mono font-semibold text-xs sm:text-sm">~160 - 210 MB (Aislado)</span>
        </div>
      </div>

      <!-- Row 3: Atajos globales -->
      <div class="py-5 grid grid-cols-12 items-center text-sm">
        <div class="col-span-6 sm:col-span-5 pr-4">
          <div class="font-bold text-white">Teclas Multimedia del Sistema</div>
          <div class="text-xs text-zinc-400 mt-0.5">Play, pausa y saltos desde cualquier app o juego</div>
        </div>
        <div class="col-span-3 sm:col-span-3 text-center text-zinc-400 text-xs">
          <span class="text-red-400">✕ Solo con foco activo</span>
        </div>
        <div class="col-span-3 sm:col-span-4 text-center sm:text-right sm:pr-4">
          <span class="text-emerald-400 font-semibold text-xs sm:text-sm">✓ Control Global 100%</span>
        </div>
      </div>

      <!-- Row 4: Visualizador de Audio -->
      <div class="py-5 grid grid-cols-12 items-center text-sm">
        <div class="col-span-6 sm:col-span-5 pr-4">
          <div class="font-bold text-white">Visualizador FFT en Tiempo Real</div>
          <div class="text-xs text-zinc-400 mt-0.5">Espectro de frecuencias dinámico a 60 FPS</div>
        </div>
        <div class="col-span-3 sm:col-span-3 text-center text-zinc-400 text-xs">
          <span class="text-red-400">✕ No disponible</span>
        </div>
        <div class="col-span-3 sm:col-span-4 text-center sm:text-right sm:pr-4">
          <span class="text-emerald-400 font-semibold text-xs sm:text-sm">✓ Web Audio Canvas</span>
        </div>
      </div>

      <!-- Row 5: Paleta reactiva -->
      <div class="py-5 grid grid-cols-12 items-center text-sm">
        <div class="col-span-6 sm:col-span-5 pr-4">
          <div class="font-bold text-white">Iluminación Ambiental Reactiva</div>
          <div class="text-xs text-zinc-400 mt-0.5">La interfaz muta de color con cada portada</div>
        </div>
        <div class="col-span-3 sm:col-span-3 text-center text-zinc-400 text-xs">
          <span class="text-zinc-400">Modo oscuro estático</span>
        </div>
        <div class="col-span-3 sm:col-span-4 text-center sm:text-right sm:pr-4">
          <span class="text-emerald-400 font-semibold text-xs sm:text-sm">✓ Motor ColorThief</span>
        </div>
      </div>

      <!-- Row 6: Mini Player -->
      <div class="py-5 grid grid-cols-12 items-center text-sm">
        <div class="col-span-6 sm:col-span-5 pr-4">
          <div class="font-bold text-white">Modo Mini Player Flotante</div>
          <div class="text-xs text-zinc-400 mt-0.5">Ventana compacta fijada sobre otras aplicaciones</div>
        </div>
        <div class="col-span-3 sm:col-span-3 text-center text-zinc-400 text-xs">
          <span class="text-red-400">✕ No soportado</span>
        </div>
        <div class="col-span-3 sm:col-span-4 text-center sm:text-right sm:pr-4">
          <span class="text-emerald-400 font-semibold text-xs sm:text-sm">✓ PiP siempre visible</span>
        </div>
      </div>

    </div>

  </div>
</section>
