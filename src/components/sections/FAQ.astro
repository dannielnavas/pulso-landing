---
import { faqsData } from '../../data/faqs';
---

<section id="faq" class="py-24 sm:py-32 border-t border-white/[0.06] relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Identifier -->
    <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-zinc-500 mb-6">
      <span class="text-[#E34222] font-bold">06</span>
      <span>//</span>
      <span>DUDAS HABITUALES</span>
    </div>

    <!-- Editorial Headline -->
    <div class="mb-14 sm:mb-16">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15] text-balance">
        Preguntas Frecuentes.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-zinc-300 font-normal leading-relaxed text-balance">
        Todo lo que necesitas saber sobre privacidad, compatibilidad con YouTube Music y seguridad.
      </p>
    </div>

    <!-- Accordion List (Borderless minimalist typography with hairline dividers) -->
    <div class="border-t border-white/10 divide-y divide-white/[0.06]">
      {faqsData.map((faq, index) => (
        <details class="group py-6 transition-colors duration-200" open={index === 0}>
          <summary class="flex items-center justify-between cursor-pointer list-none select-none text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F9EBD7] rounded-lg py-1">
            <span class="text-lg sm:text-xl font-bold text-white group-hover:text-[#F9EBD7] transition-colors pr-6">
              {faq.question}
            </span>
            <div class="w-8 h-8 rounded-full bg-zinc-900 border border-white/10 flex items-center justify-center shrink-0 text-zinc-400 group-hover:text-white group-hover:border-white/20 transition-all">
              <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <div class="mt-4 pr-12 text-sm sm:text-base text-zinc-400 leading-relaxed font-normal">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Community Link -->
    <div class="mt-12 p-6 rounded-2xl bg-zinc-900/40 border border-white/[0.06] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-bold text-white">¿Tienes alguna pregunta adicional o encontraste un bug?</h3>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1">Nuestra comunidad y código fuente están abiertos en GitHub.</p>
      </div>
      <a
        href="https://github.com/dannielnavas/ytmdannieldev/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-semibold text-xs sm:text-sm transition-colors shrink-0"
      >
        Abrir un Issue en GitHub
      </a>
    </div>

  </div>
</section>
