---
import { platformsData } from '../../data/downloads';
---

<section id="downloads" class="py-24 sm:py-32 border-t border-white/[0.06] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Identifier -->
    <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-zinc-500 mb-6">
      <span class="text-[#E34222] font-bold">05</span>
      <span>//</span>
      <span>DESCARGA OFICIAL MULTIPLATAFORMA</span>
    </div>

    <!-- Editorial Headline -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15] text-balance">
          Obtén Pulso para tu equipo.
        </h2>
        <p class="mt-4 text-base sm:text-lg text-zinc-300 font-normal leading-relaxed text-balance">
          Elige tu sistema operativo y arquitectura. Sin instaladores basura, sin telemetría.
        </p>
      </div>

      <!-- Quick Version info -->
      <div class="text-left md:text-right font-mono text-xs text-zinc-400">
        <div>Versión estable: <span class="text-white font-bold">v0.1.0</span></div>
        <div class="mt-1">Licencia: <span class="text-white font-medium">MIT Open Source</span></div>
      </div>
    </div>

    <!-- Platform Selector Tabs (Clean modern pill tabs with high tactile contrast) -->
    <div class="flex items-center gap-2 border-b border-white/[0.08] pb-4 mb-10 overflow-x-auto">
      <button
        class="platform-tab-btn px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer bg-white text-zinc-950 shadow-md"
        data-target="mac"
        aria-selected="true"
        role="tab"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.66-.99 1.73-.85 2.76 1.01.08 1.96-.51 2.58-1.26z"/></svg>
          macOS
        </span>
      </button>

      <button
        class="platform-tab-btn px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer text-zinc-400 hover:text-white hover:bg-zinc-900"
        data-target="windows"
        aria-selected="false"
        role="tab"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
          Windows
        </span>
      </button>

      <button
        class="platform-tab-btn px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer text-zinc-400 hover:text-white hover:bg-zinc-900"
        data-target="linux"
        aria-selected="false"
        role="tab"
      >
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.002 0c-3.13 0-5.672 2.628-5.672 5.867 0 1.222.378 2.355 1.018 3.292C4.167 10.74 2 13.914 2 17.653c0 3.504 2.837 6.347 6.341 6.347 1.838 0 3.493-.78 4.66-2.032a7.35 7.35 0 0 0 3.66 2.032c3.504 0 6.34-2.843 6.34-6.347 0-3.74-2.167-6.913-5.348-8.494.64-.937 1.018-2.07 1.018-3.292C18.671 2.628 16.13 0 12.002 0zm0 2.2c1.92 0 3.473 1.637 3.473 3.667 0 2.03-1.553 3.666-3.473 3.666-1.92 0-3.472-1.636-3.472-3.666 0-2.03 1.552-3.667 3.472-3.667z"/></svg>
          Linux
        </span>
      </button>
    </div>

    <!-- Platform Content Panels -->
    {platformsData.map((platform) => (
      <div
        id={`downloads-${platform.id}`}
        class={`platform-panel space-y-6 ${platform.id === 'mac' ? 'block' : 'hidden'}`}
      >
        <div class="flex items-center justify-between text-xs font-mono text-zinc-400">
          <span>Requisito de sistema: <strong class="text-zinc-200">{platform.osRequirement}</strong></span>
          <span>Arquitectura sugerida: <strong class="text-[#F9EBD7]">{platform.defaultArchitecture}</strong></span>
        </div>

        <!-- Download Cards with High Visual Focus -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {platform.architectures.map((arch) => (
            <div
              class={`relative rounded-3xl p-6 transition-all duration-300 flex flex-col justify-between ${
                arch.recommended
                  ? 'liquid-card-highlight border-2 border-[#F9EBD7]/60 shadow-2xl shadow-[#046A38]/30'
                  : 'liquid-card hover:border-white/25'
              }`}
            >
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono font-bold text-zinc-400 uppercase tracking-wider">{arch.format}</span>
                  {arch.recommended && (
                    <span class="text-[10px] font-bold uppercase tracking-wider text-[#02180c] bg-[#F9EBD7] px-2.5 py-0.5 rounded shadow-sm">
                      Recomendado
                    </span>
                  )}
                </div>

                <h3 class="text-xl font-bold text-white mt-3">{arch.label}</h3>
                <p class="text-xs text-zinc-400 mt-1 leading-relaxed">{arch.sublabel}</p>
                <div class="mt-4 font-mono text-xs text-zinc-400">Tamaño aprox: {arch.size}</div>
              </div>

              <div class="mt-8 pt-4 border-t border-white/[0.06]">
                <a
                  href={arch.url}
                  class={`w-full py-3 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all duration-200 focus:outline-none focus-visible:ring-2 active:scale-95 ${
                    arch.recommended
                      ? 'bg-[#F9EBD7] hover:bg-white text-[#02180c] shadow-lg shadow-[#F9EBD7]/20 border border-[#F9EBD7]/40'
                      : 'bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white'
                  }`}
                  download
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>Descargar {arch.format}</span>
                </a>
              </div>
            </div>
          ))}
        </div>

        {platform.id === 'mac' && (
          <div class="mt-8 p-5 sm:p-6 rounded-2xl bg-[#046A38]/20 border border-[#F9EBD7]/20 backdrop-blur-xl">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase text-[#F9EBD7]">
                  <svg class="w-4 h-4 text-[#E34222]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                  <span>Paso tras instalar en macOS (Gatekeeper)</span>
                </div>
                <p class="text-xs sm:text-sm text-zinc-300">
                  Si macOS bloquea la apertura indicando que la app no proviene de un desarrollador identificado, ejecuta en tu <strong class="text-white">Terminal</strong>:
                </p>
              </div>

              <!-- Terminal Command with One-Click Copy -->
              <div class="flex items-center gap-2 bg-zinc-950 border border-white/10 rounded-xl px-4 py-2.5 font-mono text-xs text-zinc-200 select-all shrink-0">
                <span class="text-zinc-500 select-none">$</span>
                <code id="mac-command-code">xattr -cr /Applications/Pulso.app</code>
                <button
                  id="mac-copy-btn"
                  class="ml-2 px-2.5 py-1 rounded-md bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white text-[11px] font-sans font-medium transition-colors flex items-center gap-1.5 cursor-pointer"
                  title="Copiar comando al portapapeles"
                  aria-label="Copiar comando de terminal"
                >
                  <svg id="copy-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="copy-text">Copiar</span>
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    ))}

    <!-- Verification / Integrity Note -->
    <div class="mt-12 pt-8 border-t border-white/[0.06] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-zinc-400 font-mono">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Firmas SHA-256 disponibles en cada release oficial de GitHub</span>
      </div>

      <a
        href="https://github.com/dannielnavas/ytmdannieldev/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#F9EBD7] hover:text-[#E34222] underline underline-offset-4 transition-colors"
      >
        Ver historial de versiones y notas de cambios →
      </a>
    </div>

  </div>
</section>

<script>
  function initDownloadTabs() {
    const tabs = document.querySelectorAll('.platform-tab-btn');
    const panels = document.querySelectorAll('.platform-panel');

    function switchPlatform(targetId: string) {
      tabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-target') === targetId;
        if (isMatch) {
          tab.classList.remove('text-zinc-400', 'hover:text-white', 'hover:bg-zinc-900');
          tab.classList.add('bg-white', 'text-zinc-950', 'shadow-md');
          tab.setAttribute('aria-selected', 'true');
        } else {
          tab.classList.remove('bg-white', 'text-zinc-950', 'shadow-md');
          tab.classList.add('text-zinc-400', 'hover:text-white', 'hover:bg-zinc-900');
          tab.setAttribute('aria-selected', 'false');
        }
      });

      panels.forEach((panel) => {
        if (panel.id === `downloads-${targetId}`) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        if (target) switchPlatform(target);
      });
    });

    // Auto-detect OS for initial tab selection
    const ua = window.navigator.userAgent.toLowerCase();
    if (ua.includes('win')) {
      switchPlatform('windows');
    } else if (ua.includes('linux')) {
      switchPlatform('linux');
    } else {
      switchPlatform('mac');
    }

    // Copy to clipboard for macOS command
    const copyBtn = document.getElementById('mac-copy-btn');
    const copyText = document.getElementById('copy-text');
    const commandCode = document.getElementById('mac-command-code');

    if (copyBtn && commandCode && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(commandCode.textContent?.trim() || 'xattr -cr /Applications/Pulso.app');
          copyText.textContent = '¡Copiado!';
          copyBtn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            copyText.textContent = 'Copiar';
            copyBtn.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        } catch {
          // Fallback if clipboard API restricted
          copyText.textContent = 'Selecciona y copia';
        }
      });
    }
  }

  initDownloadTabs();
</script>
