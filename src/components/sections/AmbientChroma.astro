---
---

<section id="chroma" class="py-24 sm:py-32 border-t border-white/[0.06] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Identifier -->
    <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-zinc-500 mb-6">
      <span class="text-[#E34222] font-bold">02</span>
      <span>//</span>
      <span>EXTRACCIÓN CROMÁTICA ADAPTATIVA</span>
    </div>

    <!-- Editorial Asymmetrical Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Visual Interactive Chroma Demonstration (Left column on large screens) -->
      <div class="lg:col-span-7 order-2 lg:order-1 relative">
        
        <!-- Live Chromatic Sandbox with Liquid Glass -->
        <div id="chroma-sandbox-stage" class="relative rounded-3xl liquid-card p-6 sm:p-8 transition-all duration-700 overflow-hidden">
          
          <!-- Dynamic Ambient Halo -->
          <div id="chroma-ambient-halo" class="absolute -top-10 -left-10 w-72 h-72 rounded-full bg-[#F9EBD7]/20 blur-3xl transition-all duration-700 pointer-events-none"></div>
          <div id="chroma-ambient-halo-sub" class="absolute -bottom-10 -right-10 w-72 h-72 rounded-full bg-[#046A38]/40 blur-3xl transition-all duration-700 pointer-events-none"></div>

          <!-- Content inside sandbox -->
          <div class="relative space-y-6">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.06]">
              <div>
                <span class="text-xs font-mono uppercase text-[#F9EBD7]/90">Motor cover-palette.service</span>
                <h3 class="text-base font-bold text-white mt-0.5">Muestreo cromático en vivo</h3>
              </div>
              
              <!-- Color Code Pill -->
              <div class="flex items-center gap-3 font-mono text-xs">
                <span class="text-zinc-400">Tono Dominante:</span>
                <span id="chroma-hex-value" class="px-2.5 py-1 rounded bg-black/60 border border-[#F9EBD7]/30 text-[#F9EBD7] font-bold">
                  #F9EBD7
                </span>
              </div>
            </div>

            <!-- Album covers selector to test live morphing -->
            <div class="grid grid-cols-3 gap-3 sm:gap-4">
              
              <!-- Album 1: Warm Ivory (Principal) -->
              <button
                class="chroma-picker-card group relative p-3 rounded-2xl border border-[#F9EBD7]/80 bg-black/40 text-left transition-all duration-300 hover:scale-[1.02] cursor-pointer focus:outline-none"
                data-hex="#F9EBD7"
                data-name="Marfil Acústico"
                data-artist="Verdant Studio"
                data-palette="Warm Ivory / Sand Glow / Cream"
                aria-label="Seleccionar portada marfil acústico principal"
              >
                <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-[#046A38] via-[#dfcfb9] to-[#F9EBD7] mb-2 border border-white/15 shadow-md"></div>
                <div class="text-xs font-bold text-white truncate">Marfil Acústico</div>
                <div class="text-[11px] text-[#F9EBD7]/80 truncate">Principal</div>
              </button>

              <!-- Album 2: Deep Pine (Secundario) -->
              <button
                class="chroma-picker-card group relative p-3 rounded-2xl border border-white/10 hover:border-white/25 bg-black/40 text-left transition-all duration-300 hover:scale-[1.02] cursor-pointer focus:outline-none"
                data-hex="#046A38"
                data-name="Bosque Profundo"
                data-artist="Kroma Sessions"
                data-palette="Deep Pine / Emerald Velvet / Sage"
                aria-label="Seleccionar portada bosque profundo secundario"
              >
                <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-[#02180c] via-[#046A38] to-[#078c4b] mb-2 border border-white/15 shadow-md"></div>
                <div class="text-xs font-bold text-white truncate">Bosque Profundo</div>
                <div class="text-[11px] text-[#F9EBD7]/80 truncate">Secundario</div>
              </button>

              <!-- Album 3: Vermilion Pulse (Tercero) -->
              <button
                class="chroma-picker-card group relative p-3 rounded-2xl border border-white/10 hover:border-white/25 bg-black/40 text-left transition-all duration-300 hover:scale-[1.02] cursor-pointer focus:outline-none"
                data-hex="#E34222"
                data-name="Pulso Carmesí"
                data-artist="Dominic & Solaris"
                data-palette="Flame Vermilion / Terracotta / Coral"
                aria-label="Seleccionar portada pulso carmesí tercero"
              >
                <div class="w-full aspect-square rounded-xl bg-gradient-to-tr from-[#046A38] via-[#E34222] to-[#f2502f] mb-2 border border-white/15 shadow-md"></div>
                <div class="text-xs font-bold text-white truncate">Pulso Carmesí</div>
                <div class="text-[11px] text-[#F9EBD7]/80 truncate">Tercero</div>
              </button>

            </div>

            <!-- Mini Player interface preview showing responsive lighting -->
            <div class="p-4 rounded-2xl bg-black/50 border border-white/10 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div id="chroma-preview-swatch" class="w-8 h-8 rounded-lg bg-[#F9EBD7] shadow-md transition-colors duration-500 border border-white/20"></div>
                <div>
                  <div id="chroma-preview-title" class="text-sm font-semibold text-white">Marfil Acústico — Verdant Studio</div>
                  <div id="chroma-preview-sub" class="text-xs text-[#F9EBD7]/80 font-mono">Paleta: Warm Ivory / Sand Glow / Cream</div>
                </div>
              </div>
              <span class="text-xs font-mono text-zinc-400">ΔE &lt; 1.5</span>
            </div>

          </div>

        </div>

      </div>

      <!-- Text Narrative (Right column on large screens) -->
      <div class="lg:col-span-5 order-1 lg:order-2 space-y-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15] text-balance">
          La interfaz respira y muta con cada canción.
        </h2>

        <p class="text-base sm:text-lg text-zinc-300 leading-relaxed font-normal">
          Pulso abandona los temas oscuros planos y monótonos. Mediante algoritmos de cuantización cromática y <strong class="text-white font-semibold">ColorThief</strong>, la aplicación extrae la esencia tonal de la carátula en cuanto cambia la pista.
        </p>

        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
          El resultado es un resplandor ambiental sutil y envolvente detrás de tu música: las barras de progreso, los efectos de brillo y el fondo adaptan su temperatura de color sin fatigar tu vista ni sobrecargar la GPU.
        </p>

        <div class="pt-4 border-t border-white/[0.08] space-y-3">
          <div class="flex items-center gap-3 text-sm text-zinc-300">
            <span class="w-1.5 h-1.5 rounded-full bg-[#F9EBD7]"></span>
            <span>Muestreo sin bloqueo en el hilo de renderizado</span>
          </div>
          <div class="flex items-center gap-3 text-sm text-zinc-300">
            <span class="w-1.5 h-1.5 rounded-full bg-[#046A38]"></span>
            <span>Contraste adaptativo automático para legibilidad WCAG</span>
          </div>
          <div class="flex items-center gap-3 text-sm text-zinc-300">
            <span class="w-1.5 h-1.5 rounded-full bg-[#E34222]"></span>
            <span>Transiciones cromáticas suaves con curvas bezier</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function initChromaSandbox() {
    const cards = document.querySelectorAll('.chroma-picker-card');
    const halo1 = document.getElementById('chroma-ambient-halo');
    const halo2 = document.getElementById('chroma-ambient-halo-sub');
    const hexLabel = document.getElementById('chroma-hex-value');
    const swatch = document.getElementById('chroma-preview-swatch');
    const title = document.getElementById('chroma-preview-title');
    const sub = document.getElementById('chroma-preview-sub');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        cards.forEach((c) => {
          c.classList.remove('border-[#F9EBD7]/80', 'border-[#046A38]', 'border-[#E34222]/80');
          c.classList.add('border-white/10');
        });

        const hex = card.getAttribute('data-hex') || '#F9EBD7';
        const name = card.getAttribute('data-name') || '';
        const artist = card.getAttribute('data-artist') || '';
        const palette = card.getAttribute('data-palette') || '';

        card.classList.remove('border-white/10');
        if (hex === '#046A38') {
          card.classList.add('border-[#046A38]/80');
        } else if (hex === '#E34222') {
          card.classList.add('border-[#E34222]/80');
        } else {
          card.classList.add('border-[#F9EBD7]/80');
        }

        if (halo1) halo1.style.backgroundColor = `${hex}45`;
        if (halo2) halo2.style.backgroundColor = `${hex}30`;
        if (hexLabel) {
          hexLabel.textContent = hex.toUpperCase();
          hexLabel.style.color = hex;
        }
        if (swatch) swatch.style.backgroundColor = hex;
        if (title) title.textContent = `${name} — ${artist}`;
        if (sub) sub.textContent = `Paleta: ${palette}`;
      });
    });
  }

  initChromaSandbox();
</script>
