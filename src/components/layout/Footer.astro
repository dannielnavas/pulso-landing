---
---

<footer class="border-t border-white/[0.08] bg-zinc-950 py-16 text-xs text-zinc-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <!-- Brand & Mission -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#046A38]/40 border border-[#F9EBD7]/20 flex items-center justify-center text-[#F9EBD7] shadow-md shadow-[#046A38]/30">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <span class="text-base font-bold text-white tracking-tight">Pulso</span>
        </div>
        <p class="text-zinc-400 leading-relaxed max-w-sm">
          Reproductor de escritorio de alto rendimiento para YouTube Music. Construido con Angular 22, Electron y Astro para una experiencia auditiva pura y sin distracciones.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <div class="text-xs font-mono uppercase text-[#F9EBD7]/90 font-semibold tracking-wider">Navegación</div>
        <ul class="space-y-2">
          <li><a href="#sponsorblock" class="hover:text-[#F9EBD7] transition-colors">SponsorBlock Nativo</a></li>
          <li><a href="#chroma" class="hover:text-[#F9EBD7] transition-colors">Paleta Cromática Adaptativa</a></li>
          <li><a href="#visualizer" class="hover:text-[#F9EBD7] transition-colors">Visualizador FFT</a></li>
          <li><a href="#comparativa" class="hover:text-[#F9EBD7] transition-colors">Comparativa con Navegador</a></li>
          <li><a href="#downloads" class="hover:text-[#F9EBD7] transition-colors">Descargas Oficiales</a></li>
        </ul>
      </div>

      <!-- Open Source & Project Links -->
      <div class="md:col-span-4 space-y-3">
        <div class="text-xs font-mono uppercase text-[#F9EBD7]/90 font-semibold tracking-wider">Comunidad y Código</div>
        <ul class="space-y-2">
          <li>
            <a
              href="https://github.com/dannielnavas/ytmdannieldev"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#F9EBD7] transition-colors inline-flex items-center gap-1.5"
            >
              <span>Repositorio en GitHub</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/dannielnavas/ytmdannieldev/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#F9EBD7] transition-colors inline-flex items-center gap-1.5"
            >
              <span>Releases & Changelog (v0.1.0)</span>
            </a>
          </li>
          <li>
            <a
              href="https://sponsor.ajay.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#F9EBD7] transition-colors inline-flex items-center gap-1.5"
            >
              <span>Base de Datos de SponsorBlock</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Legal Disclaimer & Copyright -->
    <div class="pt-8 border-t border-white/[0.06] space-y-3 text-[11px] leading-relaxed text-zinc-400">
      <p>
        <strong class="text-zinc-300 font-medium">Aviso Legal:</strong> Pulso es un proyecto independiente de código abierto y no está afiliado, respaldado, asociado ni patrocinado de ningún modo por YouTube, Google LLC ni Alphabet Inc. YouTube y YouTube Music son marcas registradas de Google LLC.
      </p>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-zinc-400 pt-2">
        <p>© 2026 Danniel Navas & Desarrolladores de Pulso. Licenciado bajo MIT.</p>
        <p class="font-mono">Hecho para amantes de la música.</p>
      </div>
    </div>

  </div>
</footer>
