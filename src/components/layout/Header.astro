---
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 px-4 sm:px-6 lg:px-8 pt-3 sm:pt-4 pointer-events-none">
  <div class="max-w-7xl mx-auto flex items-center justify-between pointer-events-auto liquid-pill rounded-2xl px-5 sm:px-6 h-16 sm:h-18 transition-all duration-300">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F9EBD7] rounded-xl p-1" aria-label="Pulso inicio">
      <div class="w-9 h-9 rounded-xl bg-[#046A38]/30 border border-[#F9EBD7]/30 flex items-center justify-center text-[#F9EBD7] shadow-lg shadow-[#046A38]/30 group-hover:border-[#F9EBD7]/70 group-hover:scale-105 transition-all duration-300">
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-bold text-white tracking-tight leading-none group-hover:text-[#F9EBD7] transition-colors">Pulso</span>
        <span class="text-[9px] font-mono font-medium text-[#F9EBD7]/80 tracking-wider uppercase mt-1">Liquid Audio</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 text-xs sm:text-sm font-medium text-zinc-300">
      <a href="#showcase" class="hover:text-[#F9EBD7] transition-colors py-1">Dashboard</a>
      <a href="#sponsorblock" class="hover:text-[#F9EBD7] transition-colors py-1">SponsorBlock</a>
      <a href="#chroma" class="hover:text-[#F9EBD7] transition-colors py-1">Paleta Dinámica</a>
      <a href="#visualizer" class="hover:text-[#F9EBD7] transition-colors py-1">Arquitectura</a>
      <a href="#comparativa" class="hover:text-[#F9EBD7] transition-colors py-1">Comparativa</a>
      <a href="#faq" class="hover:text-[#F9EBD7] transition-colors py-1">FAQ</a>
    </nav>

    <!-- CTAs & GitHub -->
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/dannielnavas/ytmdannieldev"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 text-xs font-medium text-zinc-300 hover:text-[#F9EBD7] hover:bg-white/10 rounded-xl transition-all border border-transparent hover:border-white/15"
        aria-label="Ver repositorio en GitHub"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <!-- High-visibility Nav CTA -->
      <a
        href="#downloads"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-bold text-[#031d10] bg-[#F9EBD7] hover:bg-white rounded-xl shadow-lg shadow-[#F9EBD7]/20 transition-all duration-200 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F9EBD7] border border-[#F9EBD7]/40"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Descargar</span>
      </a>
    </div>
  </div>
</header>
