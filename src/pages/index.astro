---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import SponsorBlockFeature from '../components/sections/SponsorBlockFeature.astro';
import AmbientChroma from '../components/sections/AmbientChroma.astro';
import DesktopExperience from '../components/sections/DesktopExperience.astro';
import Comparison from '../components/sections/Comparison.astro';
import Downloads from '../components/sections/Downloads.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout
  title="Pulso — El reproductor de YouTube Music que tu escritorio se merecía"
  description="Cliente nativo de escritorio para YouTube Music. Ultraligero, sin patrocinios con SponsorBlock integrado, visualizador de audio en tiempo real y paleta dinámica de colores. Disponible para macOS, Windows y Linux."
>
  <Header />

  <main id="main-content">
    <Hero />
    <SponsorBlockFeature />
    <AmbientChroma />
    <DesktopExperience />
    <Comparison />
    <Downloads />
    <FAQ />
  </main>

  <Footer />
</Layout>
